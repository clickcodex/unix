DB_HOST=localhost
DB_NAME=unix
DB_USER=root
DB_PASS=

# =============================================================================
# SECURE PAYMENT & UPI CONFIGURATION (PHONEPE & UPI INTEGRATION)
# =============================================================================

# Merchant UPI VPA ID (Used for live QR code scanning & direct UPI payments)
UPI_VPA_ID=your_merchant_vpa@upi
UPI_MERCHANT_NAME="Unix Marketplace"

# PhonePe Payment Gateway Credentials
# Sandbox Test MID: PGTESTPAYUAT | Production MID: Issued by PhonePe Business Portal
PHONEPE_MERCHANT_ID=PGTESTPAYUAT

# PhonePe Secret Salt Key (Keep private — do not commit to public repositories)
PHONEPE_SALT_KEY=your_phonepe_salt_key_here

# PhonePe Salt Index (Default: 1)
PHONEPE_SALT_INDEX=1

# PhonePe Environment Mode: 'sandbox' (Testing Mode) or 'production' (Live Money Mode)
PHONEPE_ENV=sandbox
